# Tool caches and generated diagnostics
.playwright-mcp/
__pycache__/
*.py[cod]

# No binary/media files in root — they bloat git history and slow obsidian-git sync
# Safe zones: assets/ and attachments/ are allowed (referenced by notes)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.svg
*.pdf
*.mp3
*.mp4
*.wav
!assets/**
!attachments/**

# Generated HTML belongs outside the vault, including media safe zones
*.html
