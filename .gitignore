# Ephemeral report files (generated by skills, not vault content)
reports/discord-recap/*.md

# Playwright MCP cache (screenshots, console logs)
.playwright-mcp/

# No binary/media files in root — they bloat git history and slow obsidian-git sync
# Safe zones: assets/ and attachments/ are allowed (referenced by notes)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.svg
*.pdf
*.mp3
*.mp4
*.wav
!assets/**
!attachments/**
